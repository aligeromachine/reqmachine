# Generated by psp (https://github.com/MatteoGuadrini/psp), version 0.8.0

PYTHON = python3
PIP = pip3
VENV = .venv

.PHONY: help all run clean test build deploy container

help:
	@echo 'help: make (help|all|run|clean|test|build|deploy|container)'

all: help all run clean test build deploy container


test:
ifneq ('$(wildcard ${VENV}/bin/${PYTHON})','')
	${VENV}/bin/${PYTHON} -m unittest
else
	${PYTHON} -m unittest
endif

build:
ifneq ('$(wildcard ${VENV}/bin/${PYTHON})','')
	${VENV}/bin/${PYTHON} -m build
else
	${PYTHON} -m build
endif

deploy:
ifneq ('$(wildcard ${VENV}/bin/${PYTHON})','')
	${VENV}/bin/${PYTHON} -m twine upload dist/*
else
	${PYTHON} -m twine upload dist/*
endif

container:
	podman build . -t reqmachine:latest || docker build . -t reqmachine:latest
run:
ifneq ('$(wildcard ${VENV}/bin/${PYTHON})','')
	${VENV}/bin/${PYTHON} -m reqmachine
else
	${PYTHON} -m reqmachine
endif

clean:
	rm -fr build/
	rm -fr dist/
	rm -fr .eggs/
	find . -name '*.egg-info' -exec rm -fr {} +
	find . -name '*.egg' -exec rm -f {} +
	find . -name '*.pyc' -exec rm -f {} +
	find . -name '*.pyo' -exec rm -f {} +
	find . -name '*~' -exec rm -f {} +
	find . -name '__pycache__' -exec rm -fr {} +
