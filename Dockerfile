FROM python:alpine

# Update and upgrade packages
RUN apk update && apk upgrade --no-cache

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Copy the Python package
COPY reqmachine /reqmachine/reqmachine
COPY pyproject.toml /reqmachine
WORKDIR /reqmachine

# Install dependencies
RUN pip install . --no-cache-dir

# Safe user
RUN adduser --disabled-password reqmachine_user
USER reqmachine_user

# Run package
ENTRYPOINT python
CMD -m reqmachine
